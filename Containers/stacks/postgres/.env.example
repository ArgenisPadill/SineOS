# PostgreSQL — nombres requeridos; copiar a .env y completar localmente.
# El archivo .env real debe permanecer fuera de Git (chmod 600).
# Reemplazar POSTGRES_IMAGE por un digest de manifest verificado antes de migrar.
POSTGRES_IMAGE=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST_PORT=
POSTGRES_DATA_DIR=
POSTGRES_CONTAINER_NAME=
